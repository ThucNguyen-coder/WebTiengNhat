# Copy this file to .env.local and fill in the values from Supabase
# (Project Settings > API Keys / Data API). These two values are public by design;
# data is protected by Row Level Security in supabase/schema.sql.
# Never put the Supabase secret / service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
