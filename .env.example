# Chép thành .env.local (hoặc đặt trong phần Environment Variables của nơi deploy)
# Token lấy ở Dify: app > Publish > Embed on website (token của widget là công khai theo thiết kế).
VITE_DIFY_TOKEN=
# Dify Cloud: để mặc định. Tự host: đổi thành địa chỉ Dify của anh, ví dụ https://dify.ten-mien.com
VITE_DIFY_BASE_URL=https://udify.app
